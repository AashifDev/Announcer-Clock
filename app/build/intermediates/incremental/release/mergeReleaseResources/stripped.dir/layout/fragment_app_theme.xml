<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".presentation.fragments.themes_fragment.AppThemeFragment">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_12sdp"
        android:id="@+id/llDarkThemeLayout"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="0dp"
        app:cardCornerRadius="@dimen/_14sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/_14sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imgTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:spinnerMode="dialog"
                android:src="@drawable/theme"
                android:tint="@color/dark_blue" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/linearLayoutCompatSound3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:textStyle="normal"
                    android:id="@+id/txtEnableDarkTheme"
                    android:gravity="center_vertical"
                    android:text="@string/enable_dark_theme_mode"
                    android:textSize="@dimen/_14ssp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/enableDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:padding="@dimen/_10sdp"
                    android:thumb="@drawable/toggle_thumb"
                    app:thumbTint="@color/dark_blue"
                    app:trackTint="@color/track_color"
                    app:track="@drawable/toggle_track" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </com.google.android.material.card.MaterialCardView>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="normal"
        android:id="@+id/txtChooseColor"
        android:text="@string/choose_theme_color_options"
        android:layout_marginTop="@dimen/_16sdp"
        app:layout_constraintTop_toBottomOf="@id/llDarkThemeLayout"
        app:layout_constraintStart_toStartOf="@id/llDarkThemeLayout"
        android:textSize="@dimen/_14ssp" />

    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/colorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:alignItems="center"
        android:layout_margin="@dimen/_16sdp"
        app:layout_constraintEnd_toEndOf="@+id/llDarkThemeLayout"
        app:layout_constraintStart_toStartOf="@id/txtChooseColor"
        app:layout_constraintTop_toBottomOf="@id/txtChooseColor" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/chooseAppColor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:background="@drawable/bg_snackbar"
        android:text="Choose color"
        android:textSize="@dimen/_16ssp"
        android:textStyle="normal"
        android:textColor="?attr/colorSurface"
        app:layout_constraintEnd_toEndOf="@+id/llDarkThemeLayout"
        app:layout_constraintStart_toStartOf="@id/txtChooseColor"
        app:layout_constraintTop_toBottomOf="@id/colorContainer" />


</androidx.constraintlayout.widget.ConstraintLayout>